{
    "latex-workshop.latex.tools": [
        {
            "name": "archive-build",
            "command": "python",
            "args": [
                "%WORKSPACE_FOLDER%/scripts/build.py",
                "%DOC%"
            ]
        },
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-halt-on-error",
                "-file-line-error",
                "%DOC%"
            ]
        }
    ],

    "latex-workshop.latex.recipes": [
        {
            "name": "Archive: editorial / combined + individual problems",
            "tools": [
                "archive-build"
            ]
        },
        {
            "name": "xelatex",
            "tools": [
                "xelatex"
            ]
        }
    ],

    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.recipe.default": "first"
}
